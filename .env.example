# ==============================================================================
# RECALL: Environment Configuration
# ==============================================================================

# Google Gemini & Google Cloud Authentication
# For Gemini API:
GEMINI_API_KEY=your-gemini-api-key-here
# For Vertex AI / Google Cloud deployment:
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini Models (Dynamically auto-discovered if not overridden)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# ClickHouse Cloud Credentials (Official mcp-clickhouse Integration)
# ClickHouse Cloud instances use port 8443 with HTTPS (CLICKHOUSE_SECURE=true)
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password-here
CLICKHOUSE_DATABASE=recall
CLICKHOUSE_SECURE=true

# Server & MCP Configuration
CLICKHOUSE_MCP_COMMAND=mcp-clickhouse
PORT=8000
DEBUG=false
